# Official release binaries, not a source build.
#
# Upstream publishes signed-checksum binaries for both architectures, so
# compiling bark ourselves buys nothing and costs a lot: the first attempt
# compiled on the VPS and exhausted its memory, the second cross-compiled under
# QEMU in CI and took tens of minutes. This takes seconds and produces the same
# binaries upstream tests and ships.
FROM debian:bookworm-slim

ARG BARK_VERSION=0.7.1
ARG TARGETARCH

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl \
    && rm -rf /var/lib/apt/lists/*

# TARGETARCH is amd64/arm64; upstream names them x86_64/arm64.
RUN set -eu; \
    case "$TARGETARCH" in \
        amd64) ARCH=x86_64 ;; \
        arm64) ARCH=arm64 ;; \
        *) echo "unsupported architecture: $TARGETARCH" >&2; exit 1 ;; \
    esac; \
    BASE="https://gitlab.com/api/v4/projects/ark-bitcoin%2Fbark/packages/generic/release-assets/bark-0%2E7%2E1"; \
    curl -fsSL "$BASE/SHA256SUMS" -o /tmp/SHA256SUMS; \
    for bin in bark barkd; do \
        curl -fsSL "$BASE/${bin}-0%2E7%2E1-linux-${ARCH}" -o "/usr/local/bin/${bin}"; \
        # Verify against upstream's own checksum file before trusting the binary.
        expected=$(grep " ${bin}-${BARK_VERSION}-linux-${ARCH}\$" /tmp/SHA256SUMS | cut -d' ' -f1); \
        actual=$(sha256sum "/usr/local/bin/${bin}" | cut -d' ' -f1); \
        [ -n "$expected" ] || { echo "no checksum for ${bin}-${BARK_VERSION}-linux-${ARCH}" >&2; exit 1; }; \
        [ "$expected" = "$actual" ] || { echo "checksum mismatch for ${bin}" >&2; exit 1; }; \
        chmod +x "/usr/local/bin/${bin}"; \
    done; \
    rm -f /tmp/SHA256SUMS; \
    bark --version

# Bun runs the gateway that sits in front of barkd.
COPY --from=oven/bun:1.4-slim /usr/local/bin/bun /usr/local/bin/bun

WORKDIR /gateway
COPY gateway/package.json gateway/bun.lock* ./
RUN bun install --frozen-lockfile --production 2>/dev/null || bun install --production
COPY gateway/ ./

COPY entrypoint.sh /usr/local/bin/entrypoint.sh
RUN chmod +x /usr/local/bin/entrypoint.sh

# barkd listens on loopback only: everything from outside goes through the
# gateway, which is the whole point of having one.
ENV BARKD_DATADIR=/data \
    BARKD_BIND_HOST=127.0.0.1 \
    BARKD_BIND_PORT=3000 \
    GATEWAY_PORT=3001 \
    BARKD_INTERNAL_URL=http://127.0.0.1:3000
EXPOSE 3001
CMD ["/usr/local/bin/entrypoint.sh"]
